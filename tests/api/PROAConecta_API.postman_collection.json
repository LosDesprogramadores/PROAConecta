{
  "info": {
    "name": "PROAConecta API",
    "description": "Tests Rúbrica",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Autenticación",
      "item": [
        {
          "name": "POST Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Guarda el token en variables\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"token\", jsonData.access);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
            "mode": "raw",
            "raw": "{\n    \"dni\": \"10000001\",\n    \"password\": \"12345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login", ""]
            }
          }
        }
      ]
    },
    {
      "name": "1. Notificaciones (Flujo CRUD)",
      "item": [
        {
          "name": "1. POST Crear Notificacion",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"El body tiene id y lo guarda\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.environment.set(\"notificacion_id\", jsonData.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
            },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"titulo\": \"Aviso General de Prueba\",\n    \"mensaje\": \"Mensaje de prueba E2E.\",\n    \"alcance\": \"TODOS\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/notificaciones/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notificaciones", ""]
            }
          }
        },
        {
          "name": "2. POST Payload Inválido (Negativa 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
            },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{ \"campo_invalido\": \"Esto va a fallar\" }"
            },
            "url": {
              "raw": "{{baseUrl}}/api/notificaciones/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notificaciones", ""]
            }
          }
        },
        {
          "name": "3. GET Listar Notificaciones",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"El listado contiene la notificacion creada\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var idBuscado = pm.environment.get(\"notificacion_id\");",
                  "    var encontrada = jsonData.some(n => n.id === idBuscado);",
                  "    pm.expect(encontrada).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/notificaciones/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notificaciones", ""]
            }
          }
        },
        {
          "name": "4. GET Sin Token (Negativa 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/notificaciones/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notificaciones", ""]
            }
          }
        },
        {
          "name": "5. PUT Actualizar Notificacion",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
            },
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"titulo\": \"Notificación Modificada\",\n    \"mensaje\": \"Mensaje actualizado.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/notificaciones/{{notificacion_id}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notificaciones", "{{notificacion_id}}", ""]
            }
          }
        },
        {
          "name": "6. DELETE Borrar Notificacion",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
            },
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/notificaciones/{{notificacion_id}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notificaciones", "{{notificacion_id}}", ""]
            }
          }
        }
      ]
    }
  ]
}