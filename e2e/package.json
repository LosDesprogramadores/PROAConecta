{
  "name": "proa-conecta-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "End-to-end tests (Playwright) for PROA Conecta. Independent from frontend/package.json.",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "postinstall": "playwright install"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.40.0"
  }
  
}
