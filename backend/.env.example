# Copiar a backend/.env y completar. NUNCA subir backend/.env al repositorio.
# Con "docker compose up" las URLs de bases y Redis se pisan desde docker-compose.yml.

# --- Django ---
KEY_SECRET=cambiar-esto
# Debe ser exactamente "True" para activar DEBUG
DJANGO_DEBUG=True
FRONTEND_URL=http://localhost:4200

# --- PostgreSQL ---
# Con compose: se ignora (apunta al contenedor "db")
# Con base en la nube: URL completa
DATABASE_URL=postgres://usuario:cambiar-esto@host:5432/base
# True para la nube (por defecto); compose lo pone en False
DB_SSL=True

# --- MongoDB ---
# Con compose: se ignora (apunta al contenedor "mongo")
# Con Atlas: mongodb+srv://usuario:cambiar-esto@cluster.mongodb.net/
DATABASE_URL_MONGODB=mongodb://localhost:27017
MONGO_DB_NAME=proa_conecta

# --- Redis (canales de WebSocket) ---
# Con compose: se ignora (apunta al contenedor "redis"). Vacío = capa en memoria
REDIS_URL=

# --- Correo ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=cambiar-esto
DEFAULT_FROM_EMAIL=

# --- Discord ---
DISCORD_WEBHOOK_URL=

# --- Gemini (opcional, sin uso activo) ---
GEMINI_API_KEY=

# --- Datos de prueba (seed_demo) ---
# Minimo 8 caracteres; solo para entornos de desarrollo
SEED_DEMO_PASSWORD=
